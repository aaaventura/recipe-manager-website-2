{
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "start:frontend": "npm run dev --workspace=client",
    "start:backend": "npm start --workspace=server",
    "dev": "concurrently \"npm run start:frontend\" \"npm run start:backend\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
